# ===== Backend =====

# Hosted LLM provider
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-google-api-key-here

# Vector store (leave empty for embedded Qdrant — no separate container needed)
# For Qdrant Cloud, set both QDRANT_URL and QDRANT_API_KEY
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=corpus

# Corpus ingestion (inside the container)
CORPUS_DIR=/data/corpus
INGESTION_ERROR_LOG=/data/ingestion_errors.jsonl

# Skip corpus ingestion on startup (set to "true" if no PDFs in ./corpus/)
SKIP_INGESTION=false

# ===== Frontend (used by the Vite dev server) =====
VITE_API_URL=http://localhost:7860

# ===== Docker Compose only =====
CORPUS_HOST_DIR=./corpus
